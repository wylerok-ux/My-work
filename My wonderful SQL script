WITH account_ifo AS (
--We are creating account-level metrics
SELECT s.date,
      se.country,
      a.is_unsubscribed,
      a.is_verified,
      a.send_interval,
      COUNT(DISTINCT id) AS account_cnt
FROM `data-analytics-mate.DA.account` a
JOIN `DA.account_session` acs  
ON a.id = acs.account_id
JOIN `DA.session_params` se  
On acs.ga_session_id = se.ga_session_id
JOIN `DA.session` s  
ON acs.ga_session_id =s.ga_session_id
GROUP BY 1,2,3,4,5
),
--Creating email metrics
cnt_msg AS(
SELECT DATE_ADD(s.date, INTERVAL es.sent_date DAY) AS date,
       sp.country,
       acc.is_unsubscribed,
       acc.is_verified,
       acc.send_interval,
       COUNT(DISTINCT es.id_message) AS sent_msg,
       COUNT(DISTINCT eo.id_message) AS open_msg,
       COUNT(DISTINCT ev.id_message) AS visit_msg
     
FROM `DA.email_sent` es  
LEFT JOIN `DA.email_open` eo  
ON es.id_message = eo.id_message
LEFT JOIN `DA.email_visit` ev  
ON es.id_message = ev.id_message
JOIN `DA.account_session` acs  
ON es.id_account = acs.account_id
JOIN `DA.account` acc  
ON acs.account_id = acc.id
JOIN `DA.session` s  
ON acs.ga_session_id = s.ga_session_id
JOIN `DA.session_params` sp  
On s.ga_session_id = sp.ga_session_id
GROUP BY  1,2,3,4,5
),
-- We are combining account and email metrics..
uniol AS(
       SELECT date,
              country,
             is_unsubscribed,
             is_verified,
             send_interval,
             account_cnt,
             0 AS sent_msg,
             0 AS open_msg,
             0 AS visit_msg,
             
       FROM account_ifo








       UNION ALL








       SELECT date,
              country,
              is_unsubscribed,
              is_verified,
              send_interval,
              0 AS account_cnt,
              sent_msg,
              open_msg,
              visit_msg,
             
             
       FROM cnt_msg),




-- We group by dimensions and sum the metrics, collapsing the rows
       union_final AS(
       SELECT date,
              country,
              send_interval,
              is_verified,
              is_unsubscribed,
              SUM(account_cnt) AS account_cnt,
              SUM(sent_msg) AS sent_msg,
              SUM(open_msg) AS open_msg,
              SUM(visit_msg) AS visit_msg
       FROM uniol
       GROUP BY 1,2,3,4,5
      ),




-- We are summing up the number of accounts by country.




 total_country_cnt AS (
       SELECT *,
              SUM(account_cnt) OVER (partition by country) AS total_country_account_cnt,
              SUM(sent_msg) OVER (partition by country) AS total_country_sent_cnt
       FROM union_final
 ),




--We add DENSE_RANK based on the number of accounts per country
rank_total_cnt AS (
 SELECT *,
       DENSE_RANK() OVER(order by total_country_account_cnt DESC) AS rank_total_country_account_cnt,
       DENSE_RANK() OVER(order by total_country_sent_cnt DESC) AS rank_total_country_sent_cnt
 FROM total_country_cnt
)
--adding sorting








SELECT *
FROM rank_total_cnt
where rank_total_country_account_cnt <=10 or rank_total_country_sent_cnt <=10
